# URL publique du site (OG, sitemap, canonical). Sans slash final.
NEXT_PUBLIC_SITE_URL=https://data-quest.fr

# Web3Forms (https://web3forms.com) : la clé d'accès est liée à l'adresse qui reçoit
# les demandes (définie à la création de la clé). Sans clé, les demandes sont
# écrites dans .leads/ (développement uniquement).
WEB3FORMS_ACCESS_KEY=

# Optionnel : nombre max de demandes par IP et par 10 minutes (défaut 5).
# LEAD_RATE_LIMIT=5
