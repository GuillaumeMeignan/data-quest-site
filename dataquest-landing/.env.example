# URL publique du site (OG, sitemap, canonical). Sans slash final.
NEXT_PUBLIC_SITE_URL=https://data-quest.fr

# Clé d'accès Web3Forms (https://web3forms.com), liée à l'adresse qui reçoit les demandes.
# Publique par conception (le site est statique) : elle part dans le JavaScript du navigateur.
# Sans clé, en développement : rien n'est envoyé et la confirmation s'affiche quand même.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
