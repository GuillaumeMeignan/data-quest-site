# URL publique du site (OG, sitemap, canonical). Sans slash final.
NEXT_PUBLIC_SITE_URL=https://example.com

# Mailjet (https://app.mailjet.com/account/apikeys). Sans ces clés, les demandes
# sont écrites dans .leads/ (développement uniquement).
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Expéditeur : adresse/domaine à valider dans Mailjet (SPF/DKIM).
MAIL_FROM=contact@example.com

# Destinataire des notifications de demande.
LEAD_NOTIFY_EMAIL=contact@example.com

# Optionnel : nombre max de demandes par IP et par 10 minutes (défaut 5).
# LEAD_RATE_LIMIT=5
